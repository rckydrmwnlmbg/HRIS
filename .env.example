# ==============================================================================
# KONFIGURASI DATABASE & ENVIRONMENT HRIS
# ==============================================================================

# Mode Data:
# - 'live' : Mengaktifkan koneksi database aktif (wajib untuk membaca data)
DATA_MODE="live"

# ------------------------------------------------------------------------------
# OPSI 1: PostgreSQL / Supabase (Direkomendasikan untuk pengembangan & data dummy)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
DB_TYPE="postgres"

# ------------------------------------------------------------------------------
# OPSI 2: Microsoft SQL Server / DataSolution (Digunakan untuk lingkungan on-premise)
# ------------------------------------------------------------------------------
# DB_SERVER="localhost"
# DB_NAME="HRIS_DB"
# DB_USER="sa"
# DB_PASS="your_password"
# DB_PORT="1433"
# DB_APP_NAME="Payroll Management Support"
# DB_WORKSTATION_ID="TMNB-D101-NILA"
# DB_ODBC_DRIVER="ODBC Driver 18 for SQL Server"
# DB_TRUSTED="0"
